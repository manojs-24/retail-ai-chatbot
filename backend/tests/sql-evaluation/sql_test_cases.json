  {
    "id": "conv01",
    "role": "customer",
    "description": "Conversational: pronoun resolution — reviews should resolve to P0023",
    "turns": [
      {
        "user": "Tell me about product P0023",
        "expected_intent": "PRODUCT_INFO",
        "expected_product_id": "P0023"
      },
      {
        "user": "Give its reviews",
        "expected_intent": "PRODUCT_REVIEW",
        "expected_product_id": "P0023",
        "note": "product_id must be resolved from prior context"
      }
    ]
  },
  {
    "id": "conv02",
    "role": "customer",
    "description": "Conversational: switch product — reviews should resolve to latest product P0045",
    "turns": [
      {
        "user": "Tell me about P0023",
        "expected_intent": "PRODUCT_INFO",
        "expected_product_id": "P0023"
      },
      {
        "user": "Tell me about P0045",
        "expected_intent": "PRODUCT_INFO",
        "expected_product_id": "P0045"
      },
      {
        "user": "Give its reviews",
        "expected_intent": "PRODUCT_REVIEW",
        "expected_product_id": "P0045",
        "note": "product_id must resolve to MOST RECENT product P0045, not P0023"
      }
    ]
  },
  {
    "id": "conv03",
    "role": "manager",
    "description": "Conversational manager: order then context reference",
    "turns": [
      {
        "user": "Show me order ORD00002",
        "expected_intent": "ORDER_DETAILS",
        "expected_order_id": "ORD00002"
      },
      {
        "user": "Who is the customer for this order?",
        "expected_intent": "ORDER_DETAILS",
        "expected_order_id": "ORD00002",
        "note": "order_id must be resolved from prior context"
      }
    ]
  }
]
